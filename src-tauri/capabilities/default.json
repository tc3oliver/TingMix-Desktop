{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: IPC events plus exactly the app commands it needs. No fs, shell, http or updater plugin permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "allow-list-input-devices",
    "allow-live-start",
    "allow-live-stop",
    "allow-live-snapshot",
    "allow-file-pick",
    "allow-file-start",
    "allow-file-cancel",
    "allow-file-jobs",
    "allow-export-text",
    "allow-settings-get",
    "allow-settings-set",
    "allow-history-list",
    "allow-history-load",
    "allow-history-delete",
    "allow-diagnostics",
    "allow-models-overview",
    "allow-models-import",
    "allow-models-begin-install",
    "allow-models-install",
    "allow-models-cancel",
    "allow-models-activate",
    "allow-models-rollback",
    "allow-models-remove",
    "allow-models-verify",
    "allow-models-probe",
    "allow-backend-state",
    "allow-setup-check",
    "allow-open-licence-url",
    "allow-updater-check",
    "allow-updater-install",
    "allow-mic-permission-status",
    "allow-mic-permission-request",
    "allow-mic-open-settings"
  ]
}