{
  "name": "tingmix-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Local speech recognition desktop app (Tauri 2, React, Rust)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tc3oliver/TingMix-Desktop.git"
  },
  "bugs": {
    "url": "https://github.com/tc3oliver/TingMix-Desktop/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "bundle:macos": "tauri build --bundles app,dmg --config src-tauri/tauri.ort-macos.conf.json",
    "bundle:macos:debug": "tauri build --debug --bundles app --config src-tauri/tauri.ort-macos.conf.json",
    "bundle:windows": "sh tools/stage-onnx-worker.sh release && tauri build --bundles nsis --config src-tauri/tauri.ort-windows.conf.json",
    "bundle:windows:offline": "sh tools/stage-onnx-worker.sh release && tauri build --bundles nsis --config src-tauri/tauri.ort-windows.conf.json --config src-tauri/tauri.windows-offline.conf.json",
    "shots": "PLAYWRIGHT_BROWSERS_PATH=$HOME/.cache/ms-playwright node tools/ui-shots/shoot.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "^1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
